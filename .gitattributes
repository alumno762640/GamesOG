# Normaliza el texto y conserva LF para los archivos ejecutados en Linux.
* text=auto
*.sh text eol=lf
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.svg text eol=lf
*.jpg binary
*.jpeg binary
*.png binary
